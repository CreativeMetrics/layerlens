{
  "manifest_version": 3,
  "name": "LayerLens",
  "version": "5.11.0",
  "description": "Vedi dentro il tuo GTM: filtri e strumenti per Tag Manager + inspector del dataLayer.",
  "icons": {
    "16": "img/icon-16.png",
    "32": "img/icon-32.png",
    "48": "img/icon-48.png",
    "128": "img/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "permissions": [
    "tabs",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "cookies",
    "webNavigation",
    "scripting",
    "webRequest",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/block-page-change.content.ts-loader-DkZaehDn.js",
        "assets/qol-changes.content.ts-loader-NeQYHpmZ.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "js": [
        "assets/datalayer-checker.content.ts-loader-CRchmbJs.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "assets/shopify-sandbox.content.ts-BWeuvOOZ.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "img/*",
        "img/tag/*",
        "img/trigger/*",
        "img/variable/*",
        "assets/storage-DQyFDKmw.js",
        "assets/block-page-change.content.ts-ComrqY3Y.js",
        "assets/qol-changes.inject.ts-D2p4aHNR.js",
        "assets/tag-assistant.inject.ts-BryzDnST.js",
        "assets/consent-C5hJbv_N.js",
        "assets/qol-changes.content.ts-BS7J1QQU.js",
        "assets/datalayer-checker.inject.ts-1-V59ZF_.js",
        "assets/datalayer-checker.content.ts-DNghxkDy.js",
        "assets/shopify-sandbox.inject.ts-yX4ykfcv.js",
        "assets/shopify-sandbox.content.ts-BWeuvOOZ.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
